# TaskMaster AI - Environment Variables
# Copy to .env.local and fill in values

# Firebase (client config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Stripe - publishable key only (DO NOT put secret key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Firebase Functions base URL (optional, has default)
# VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-taskmaster-ai-e2302.cloudfunctions.net

# Emulators (optional)
# VITE_USE_EMULATORS=false
