{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts", 
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist", 
        "buildCommand": "npm run build" 
      }
    }
  ],
  "routes": [
    
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    
    
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    
    
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|mp4|webm|json|xml|txt)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
          
        }
      ],
      "continue": true 
    },
    
    {
      "source": "/(favicon.ico|manifest.json|robots.txt|sitemap.xml|og-image.png|vite.svg|apple-icon.*.png|android-icon.*.png|ms-icon.*.png|pdf.worker.min.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
          
        }
      ]
    },
    
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "headers": { 
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/index.html"
    }
  ],
  "trailingSlash": false, 
  "cleanUrls": true 
}
