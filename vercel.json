{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node" 
    },
    {
      "src": "package.json", 
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist" 
      }
    }
  ],
  "rewrites": [
    
    {
      "source": "/_/auth/handler",
      "destination": "/auth/handler"
    },
    
    {
      "source": "/((?!api/).*)", 
      "destination": "/index.html"
    }
  ]
  
}
